# Створюється скриптом deploy/deploy.sh лише якщо .env ще немає; існуючий .env скрипт не змінює.
# Ключі Gemini і токен Telegram впишіть самі, потім: sudo systemctl restart autohubkr-web autohubkr-bot
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_ALLOWED_HOSTS=__SERVER_NAME__
DJANGO_CSRF_TRUSTED_ORIGINS=http://__SERVER_NAME__
SITE_URL=http://__SERVER_NAME__
# 1 лише коли сайт відкривається за https (з'явиться домен і сертифікат)
DJANGO_HTTPS=0
CACHE_BACKEND=db

DB_NAME=autohubkr
DB_USER=autohubkr
DB_PASSWORD=__DB_PASSWORD__
DB_HOST=127.0.0.1
DB_PORT=5432

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_THINKING_BUDGET=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
