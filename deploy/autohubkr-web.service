[Unit]
Description=АвтоХаб КР: сайт (gunicorn)
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/autohubkr/app
# Лише локальна адреса: назовні сайт віддає nginx. Порт не повинен збігатися з іншими сервісами на сервері.
ExecStart=/srv/autohubkr/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8390 --workers 2 --threads 4 --timeout 60 \
    --max-requests 1000 --max-requests-jitter 100 \
    --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
# Сервер спільний з іншими проєктами й має 2 ГБ: наш процес не може з'їсти більше за ліміт і зачепити сусідів.
MemoryHigh=380M
MemoryMax=450M
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
