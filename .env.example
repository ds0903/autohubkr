# Скопіюйте цей файл у .env і заповніть значення. .env у git не потрапляє.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (локальний, версія 17)
DB_NAME=autohubkr
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# секунд очікування відповіді Gemini; після цього сайт/бот переходить на резервний підбір за ключовими словами
GEMINI_TIMEOUT_SECONDS=20
# 0 = без «мислення» (швидше вдвічі); порожньо = типова поведінка моделі
GEMINI_THINKING_BUDGET=0

# Telegram-бот (@BotFather)
TELEGRAM_BOT_TOKEN=
# ім'я бота без «@» для кнопки «Підключити Telegram» у профілі (необов'язково: за наявності токена воно визначається саме).
# Поки бота немає, блок про Telegram у профілі не показується.
TELEGRAM_BOT_USERNAME=
